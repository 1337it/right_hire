   "options": "<div class=\"schedule-info\" style=\"font-size: 12px;\">\n<style>.schedule-table { border-collapse: collapse; width: 100%; margin-bottom: 10px; } .schedule-table th, .schedule-table td { border: 1px solid #d1d8dd; padding: 6px 10px; text-align: left; } .schedule-table th { background: #f7f7f7; font-weight: bold; } .peak { background: #fff3cd; } .low-peak { background: #d4edda; } .off-peak { background: #e2e3e5; }</style>\n<h5>Normal Timing</h5>\n<table class=\"schedule-table\">\n<tr><th>Schedule</th><th>Time Slots</th></tr>\n<tr class=\"peak\"><td><b>Peak</b></td><td>6-10 AM, 4-8 PM</td></tr>\n<tr class=\"low-peak\"><td><b>Low-Peak</b></td><td>10 AM-4 PM, 8 PM-1 AM</td></tr>\n<tr class=\"off-peak\"><td><b>Off-Peak</b></td><td>1-6 AM</td></tr>\n</table>\n<h5>Ramadan Timing</h5>\n<table class=\"schedule-table\">\n<tr><th>Schedule</th><th>Time Slots</th></tr>\n<tr class=\"peak\"><td><b>Peak</b></td><td>9 AM-5 PM</td></tr>\n<tr class=\"low-peak\"><td><b>Low-Peak</b></td><td>7-9 AM, 5 PM-2 AM</td></tr>\n<tr class=\"off-peak\"><td><b>Off-Peak</b></td><td>2-7 AM</td></tr>\n</table>\n</div>"
