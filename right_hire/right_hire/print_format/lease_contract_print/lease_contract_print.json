{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2024-01-01 00:00:00",
 "css": ".print-format {\n        font-family: Arial, sans-serif;\n        color: #000;\n        line-height: 1.3;\n        margin: 0 auto;\n        background: white;\n        width:100%;\n        padding:0!important;\n    }",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Lease Agreement",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n    }\n\n    .print-format {\n        font-family: Arial, sans-serif;\n        color: #000;\n        line-height: 1.3;\n        margin: 0 auto;\n        background: white;\n        width:100%;\n        padding:0!important;\n    }\n\n    /* Page container */\n    .page {\n        width: 210mm;\n        min-height: 297mm;\n        padding: 8mm 10mm;\n        position: relative;\n        display: flex;\n        flex-direction: column;\n    }\n\n    .page-content {\n        flex: 1;\n    }\n\n    /* Header Section */\n    .gold-header {\n        background: white;\n        border: 2px solid #B8860B;\n        padding: 8px 12px;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin-bottom: 8px;\n    }\n\n    .header-left {\n        color: #000;\n        flex: 1;\n    }\n\n    .company-name {\n        font-size: 14px;\n        font-weight: bold;\n        margin-bottom: 2px;\n        text-transform: uppercase;\n    }\n\n    .company-address {\n        font-size: 9px;\n        line-height: 1.3;\n    }\n\n    .header-logo {\n        width: 120px;\n        height: 60px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .header-logo img {\n        max-width: 100%;\n        max-height: 60px;\n    }\n\n    /* Document Title */\n    .document-title {\n        text-align: center;\n        font-size: 16px;\n        font-weight: bold;\n        margin: 8px 0;\n        text-transform: uppercase;\n    }\n\n    /* Contract Header Row */\n    .contract-header {\n        border: 1px solid #000;\n        display: flex;\n        margin-bottom: 6px;\n    }\n\n    .contract-header-item {\n        padding: 5px 10px;\n        flex: 1;\n        display: flex;\n        justify-content: space-between;\n        border-right: 1px solid #000;\n        font-size: 10px;\n    }\n\n    .contract-header-item:last-child {\n        border-right: none;\n    }\n\n    .header-label {\n        font-weight: bold;\n    }\n\n    /* Two Column Layout */\n    .two-column-container {\n        display: flex;\n        gap: 6px;\n        margin-bottom: 6px;\n    }\n\n    .left-column, .right-column {\n        flex: 1;\n        border: 1px solid #000;\n    }\n\n    /* Section Boxes */\n    .section-box {\n        border: 1px solid #000;\n        margin-bottom: 6px;\n    }\n\n    .section-header {\n        background: #e8e8e8;\n        padding: 4px 8px;\n        font-weight: bold;\n        font-size: 10px;\n        text-transform: uppercase;\n        border-bottom: 1px solid #000;\n    }\n\n    .section-content {\n        padding: 6px 10px;\n    }\n\n    .info-row {\n        display: flex;\n        margin-bottom: 3px;\n        font-size: 10px;\n    }\n\n    .info-label {\n        font-weight: bold;\n        min-width: 85px;\n    }\n\n    .info-value {\n        flex: 1;\n    }\n\n    /* Compact info grid */\n    .info-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 3px 12px;\n    }\n\n    .info-grid-3 {\n        display: grid;\n        grid-template-columns: 1fr 1fr 1fr;\n        gap: 3px 12px;\n    }\n\n    .info-grid-4 {\n        display: grid;\n        grid-template-columns: 1fr 1fr 1fr 1fr;\n        gap: 3px 10px;\n    }\n\n    /* Services Table */\n    .services-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 10px;\n    }\n\n    .services-table td {\n        padding: 4px 6px;\n        border-bottom: 1px solid #ddd;\n    }\n\n    .services-table .desc-col {\n        width: 50%;\n    }\n\n    .services-table .calc-col {\n        width: 25%;\n        text-align: center;\n    }\n\n    .services-table .amount-col {\n        width: 25%;\n        text-align: right;\n        font-weight: bold;\n    }\n\n    .services-table .discount-row td {\n        color: #cc0000;\n    }\n\n    .services-table .total-row {\n        font-weight: bold;\n        border-top: 1px solid #000;\n        background: #f5f5f5;\n    }\n\n    .services-table .total-row td {\n        padding: 4px 6px;\n        border-bottom: none;\n    }\n\n    .services-table .grand-total-row {\n        font-weight: bold;\n        font-size: 11px;\n        background: #e8e8e8;\n    }\n\n    .services-table .grand-total-row td {\n        padding: 6px;\n        border-top: 1px solid #000;\n    }\n\n    /* Signature Section */\n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        gap: 15px;\n        margin-top: auto;\n        padding-top: 10px;\n    }\n\n    .signature-box {\n        flex: 1;\n        text-align: center;\n        padding: 8px;\n        border: 1px solid #000;\n    }\n\n    .signature-line {\n        border-top: 1px solid #000;\n        margin: 40px 15px 8px 15px;\n    }\n\n    .signature-label {\n        font-size: 9px;\n        font-weight: bold;\n    }\n\n    .signature-name {\n        font-size: 9px;\n        margin-top: 3px;\n    }\n\n    /* Terms Page */\n    .terms-header {\n        text-align: center;\n        font-size: 11px;\n        font-weight: bold;\n        margin-bottom: 4px;\n        text-transform: uppercase;\n        border-bottom: 1px solid #000;\n        padding-bottom: 3px;\n    }\n\n    .terms-content {\n        font-size: 7px;\n        line-height: 1.2;\n        text-align: justify;\n        column-count: 2;\n        column-gap: 10px;\n    }\n\n    .terms-content p {\n        margin-bottom: 2px;\n    }\n\n    .terms-content ol, .terms-content ul {\n        margin-left: 10px;\n        margin-bottom: 2px;\n    }\n\n    .terms-content li {\n        margin-bottom: 1px;\n    }\n\n    .terms-content h3, .terms-content h4, .terms-content strong {\n        font-size: 7px;\n    }\n\n    /* Footer */\n    .page-footer {\n        text-align: center;\n        font-size: 9px;\n        padding-top: 5px;\n        border-top: 1px solid #ccc;\n        margin-top: 5px;\n    }\n\n    /* Print styles */\n    @media print {\n        .page {\n            page-break-after: always;\n            break-after: page;\n        }\n        .page:last-child {\n            page-break-after: avoid;\n            break-after: avoid;\n        }\n        body {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n    }\n\n    @page {\n        size: A4;\n        margin: 0;\n    }\n</style>\n\n<div class=\"print-format\">\n    <!-- PAGE 1: Agreement Details -->\n    <div class=\"page\">\n        <div class=\"page-content\">\n            <!-- Header -->\n            <div class=\"gold-header\">\n                <div class=\"header-left\">\n                    <div class=\"company-name\">{{ frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }}</div>\n                    <div class=\"company-address\">\n                        {% set company_doc = frappe.get_doc(\"Company\", frappe.db.get_default(\"company\")) if frappe.db.get_default(\"company\") else None %}\n                        {% if company_doc %}\n                        {{ company_doc.address or \"\" }} | {{ company_doc.city or \"\" }} {{ company_doc.country or \"\" }} | Tel: {{ company_doc.phone_no or \"\" }}\n                        {% endif %}\n                    </div>\n                </div>\n                <div class=\"header-logo\">\n                    <img src=\"/files/logo.png\" alt=\"Logo\">\n                </div>\n            </div>\n\n            <!-- Title -->\n            <div class=\"document-title\">Vehicle Lease Agreement</div>\n\n            <!-- Contract Header -->\n            <div class=\"contract-header\">\n                <div class=\"contract-header-item\">\n                    <span class=\"header-label\">Agreement No:</span>\n                    <span>{{ doc.name }}</span>\n                </div>\n                <div class=\"contract-header-item\">\n                    <span class=\"header-label\">Start:</span>\n                    <span>{{ frappe.utils.formatdate(doc.start_date, \"dd-MMM-yy\") if doc.start_date else \"\" }}</span>\n                </div>\n                <div class=\"contract-header-item\">\n                    <span class=\"header-label\">End:</span>\n                    <span>{{ frappe.utils.formatdate(doc.end_date, \"dd-MMM-yy\") if doc.end_date else \"\" }}</span>\n                </div>\n                <div class=\"contract-header-item\">\n                    <span class=\"header-label\">Tenure:</span>\n                    <span>{{ doc.tenure_months or 0 }} Months</span>\n                </div>\n            </div>\n\n            <!-- Lessor & Lessee -->\n            <div class=\"two-column-container\">\n                <div class=\"left-column\">\n                    <div class=\"section-header\">Lessor</div>\n                    <div class=\"section-content\">\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Company:</div>\n                            <div class=\"info-value\">{{ frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }}</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"right-column\">\n                    <div class=\"section-header\">Lessee (Customer)</div>\n                    <div class=\"section-content\">\n                        <div class=\"info-grid\">\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Name:</div>\n                                <div class=\"info-value\">{{ doc.customer_name or doc.customer or \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Renter Code:</div>\n                                <div class=\"info-value\">{{ doc.renter_code or \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Mobile:</div>\n                                <div class=\"info-value\">{{ doc.contact_mobile or \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Landline:</div>\n                                <div class=\"info-value\">{{ doc.landline_no or \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Email:</div>\n                                <div class=\"info-value\">{{ doc.contact_email or \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Address:</div>\n                                <div class=\"info-value\">{{ doc.customer_address or \"-\" }}</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Vehicle Details -->\n            <div class=\"section-box\">\n                <div class=\"section-header\">Vehicle Details</div>\n                <div class=\"section-content\">\n                    <div class=\"info-grid-3\">\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Type:</div>\n                            <div class=\"info-value\">{{ doc.vehicle_type or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Plate No:</div>\n                            <div class=\"info-value\">{{ doc.plate_no or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Color:</div>\n                            <div class=\"info-value\">{{ doc.vehicle_color or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Fleet No:</div>\n                            <div class=\"info-value\">{{ doc.fleet_no or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Chassis:</div>\n                            <div class=\"info-value\">{{ doc.chassis_number or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Year:</div>\n                            <div class=\"info-value\">{{ doc.vehicle_year or \"-\" }}</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Driver Details -->\n            <div class=\"section-box\">\n                <div class=\"section-header\">Driver Details</div>\n                <div class=\"section-content\">\n                    <div class=\"info-grid-4\">\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Name:</div>\n                            <div class=\"info-value\">{{ doc.driver_name or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Mobile:</div>\n                            <div class=\"info-value\">{{ doc.driver_mobile or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">EID No:</div>\n                            <div class=\"info-value\">{{ doc.eid_no or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">EID Exp:</div>\n                            <div class=\"info-value\">{{ frappe.utils.formatdate(doc.eid_exp_date, \"dd-MMM-yy\") if doc.eid_exp_date else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">EID Issue:</div>\n                            <div class=\"info-value\">{{ frappe.utils.formatdate(doc.eid_issue_date, \"dd-MMM-yy\") if doc.eid_issue_date else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Passport:</div>\n                            <div class=\"info-value\">{{ doc.passport_number or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Pass Issue:</div>\n                            <div class=\"info-value\">{{ frappe.utils.formatdate(doc.passport_issue_date, \"dd-MMM-yy\") if doc.passport_issue_date else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Pass Exp:</div>\n                            <div class=\"info-value\">{{ frappe.utils.formatdate(doc.passport_exp_date, \"dd-MMM-yy\") if doc.passport_exp_date else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">License No:</div>\n                            <div class=\"info-value\">{{ doc.driving_license_no or \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Lic Issue:</div>\n                            <div class=\"info-value\">{{ frappe.utils.formatdate(doc.license_issued_date, \"dd-MMM-yy\") if doc.license_issued_date else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Lic Exp:</div>\n                            <div class=\"info-value\">{{ frappe.utils.formatdate(doc.driving_license_exp_date, \"dd-MMM-yy\") if doc.driving_license_exp_date else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Issued By:</div>\n                            <div class=\"info-value\">{{ doc.license_issued_by or \"-\" }}</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- OUT/IN Details -->\n            <div class=\"two-column-container\">\n                <div class=\"left-column\">\n                    <div class=\"section-header\">OUT Details</div>\n                    <div class=\"section-content\">\n                        <div class=\"info-grid\">\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Date/Time:</div>\n                                <div class=\"info-value\">{{ frappe.utils.format_datetime(doc.out_datetime, \"dd-MMM-yy HH:mm\") if doc.out_datetime else \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">KM:</div>\n                                <div class=\"info-value\">{{ \"{:,}\".format(doc.out_km|int) if doc.out_km else \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Fuel:</div>\n                                <div class=\"info-value\">{{ doc.out_fuel_level or \"-\" }}</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"right-column\">\n                    <div class=\"section-header\">Expected IN Details</div>\n                    <div class=\"section-content\">\n                        <div class=\"info-grid\">\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Date/Time:</div>\n                                <div class=\"info-value\">{{ frappe.utils.format_datetime(doc.expected_in_datetime, \"dd-MMM-yy HH:mm\") if doc.expected_in_datetime else \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">KM:</div>\n                                <div class=\"info-value\">{{ \"{:,}\".format(doc.expected_in_km|int) if doc.expected_in_km else \"-\" }}</div>\n                            </div>\n                            <div class=\"info-row\">\n                                <div class=\"info-label\">Fuel:</div>\n                                <div class=\"info-value\">{{ doc.expected_in_fuel_level or \"-\" }}</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Services & Charges -->\n            <div class=\"section-box\">\n                <div class=\"section-header\">Services & Charges</div>\n                <div class=\"section-content\">\n                    <table class=\"services-table\">\n                        <tbody>\n                            {% set monthly_rate = doc.monthly_rate or 0 %}\n                            {% set tenure = doc.tenure_months or 0 %}\n                            {% set rent_total = monthly_rate * tenure %}\n                            <tr>\n                                <td class=\"desc-col\">Rent</td>\n                                <td class=\"calc-col\">{{ tenure }} x {{ \"{:,.2f}\".format(monthly_rate) }}/Month</td>\n                                <td class=\"amount-col\">{{ \"{:,.2f}\".format(rent_total) }}</td>\n                            </tr>\n                            <tr>\n                                <td class=\"desc-col\">CDW {% if doc.cdw_deductible %}(Deductible: {{ \"{:,.0f}\".format(doc.cdw_deductible) }}/Incident){% endif %}</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">{{ \"{:,.2f}\".format(doc.cdw_charges or 0) }}</td>\n                            </tr>\n                            <tr>\n                                <td class=\"desc-col\">Fuel</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">{{ \"{:,.2f}\".format(doc.fuel_charges or 0) }}</td>\n                            </tr>\n                            <tr>\n                                <td class=\"desc-col\">Mileage (Incl: {{ \"{:,}\".format(doc.included_km|int) if doc.included_km else 0 }} KM{% if doc.excess_km_charges %}, Excess: {{ \"{:,.2f}\".format(doc.excess_km_charges) }}/KM{% endif %})</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">{{ \"{:,.2f}\".format(doc.mileage_charges or 0) }}</td>\n                            </tr>\n                            <tr>\n                                <td class=\"desc-col\">Additional Driver</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">{{ \"{:,.2f}\".format(doc.additional_driver_charges or 0) }}</td>\n                            </tr>\n                            <tr>\n                                <td class=\"desc-col\">Extra Charges</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">{{ \"{:,.2f}\".format(doc.extra_charges or 0) }}</td>\n                            </tr>\n                            {% if doc.discount_amount %}\n                            <tr class=\"discount-row\">\n                                <td class=\"desc-col\">Discount</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">({{ \"{:,.2f}\".format(doc.discount_amount) }})</td>\n                            </tr>\n                            {% endif %}\n                            <tr class=\"total-row\">\n                                <td class=\"desc-col\">Tax ({{ doc.tax_percentage or 0 }}%)</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">{{ \"{:,.2f}\".format(doc.tax_amount or 0) }}</td>\n                            </tr>\n                            <tr class=\"grand-total-row\">\n                                <td class=\"desc-col\">Grand Total</td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">AED {{ \"{:,.2f}\".format(doc.grand_total or 0) }}</td>\n                            </tr>\n                            <tr>\n                                <td class=\"desc-col\"><strong>Amount Received</strong></td>\n                                <td class=\"calc-col\"></td>\n                                <td class=\"amount-col\">AED {{ \"{:,.2f}\".format(doc.amount_received or 0) }}</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n\n            <!-- Excess Charges -->\n            <div class=\"section-box\">\n                <div class=\"section-header\">Excess Charges (If Applicable)</div>\n                <div class=\"section-content\">\n                    <div class=\"info-grid-4\">\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Excess KM:</div>\n                            <div class=\"info-value\">AED {{ \"{:,.2f}\".format(doc.excess_km_charges or 0) }}/KM</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Excess Ins:</div>\n                            <div class=\"info-value\">AED {{ \"{:,.2f}\".format(doc.excess_insurance_amount or 0) }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Salik:</div>\n                            <div class=\"info-value\">{{ doc.salik_percentage or 0 }}%</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Per Fine:</div>\n                            <div class=\"info-value\">AED {{ \"{:,.2f}\".format(doc.excess_per_traffic_fine or 0) }}</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Special Terms & Notes -->\n            {% if doc.special_terms or doc.notes or doc.additional_notes %}\n            <div class=\"section-box\">\n                <div class=\"section-header\">Special Terms / Notes</div>\n                <div class=\"section-content\" style=\"font-size: 7px;\">\n                    {% if doc.special_terms %}{{ doc.special_terms }}{% endif %}\n                    {% if doc.notes %} {{ doc.notes }}{% endif %}\n                    {% if doc.additional_notes %} {{ doc.additional_notes }}{% endif %}\n                </div>\n            </div>\n            {% endif %}\n        </div>\n\n        <!-- Signatures - Page 1 -->\n        <div class=\"signature-section\">\n            <div class=\"signature-box\">\n                <div class=\"signature-line\"></div>\n                <div class=\"signature-label\">Lessor Signature & Stamp</div>\n                <div class=\"signature-name\">{{ frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }}</div>\n            </div>\n            <div class=\"signature-box\">\n                <div class=\"signature-line\"></div>\n                <div class=\"signature-label\">Lessee Signature</div>\n                <div class=\"signature-name\">{{ doc.customer_name or doc.customer or \"\" }}</div>\n            </div>\n        </div>\n\n        <div class=\"page-footer\">\n            Agreement No: {{ doc.name }} | Date: {{ frappe.utils.formatdate(frappe.utils.nowdate(), \"dd-MMM-yyyy\") }} | Page 1 of 2\n        </div>\n    </div>\n\n    <!-- PAGE 2: Terms and Conditions -->\n    {% if doc.terms_and_conditions %}\n    <div class=\"page\" style=\"padding: 6mm 8mm;\">\n        <div class=\"page-content\">\n            <!-- Small Header for Page 2 -->\n            <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #B8860B; padding-bottom: 3px; margin-bottom: 4px;\">\n                <div style=\"font-size: 9px; font-weight: bold;\">{{ frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }}</div>\n                <div style=\"font-size: 8px;\">Agreement: {{ doc.name }} | {{ doc.customer_name or doc.customer }}</div>\n            </div>\n\n            <div class=\"terms-header\">Terms and Conditions</div>\n\n            <div class=\"terms-content\">\n                {{ frappe.render_template(doc.terms_and_conditions, {\"doc\": doc, \"frappe\": frappe}) }}\n            </div>\n        </div>\n\n        <!-- Signatures - Page 2 -->\n        <div class=\"signature-section\">\n            <div class=\"signature-box\">\n                <div class=\"signature-line\"></div>\n                <div class=\"signature-label\">Lessor Signature & Stamp</div>\n                <div class=\"signature-name\">{{ frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }}</div>\n            </div>\n            <div class=\"signature-box\">\n                <div class=\"signature-line\"></div>\n                <div class=\"signature-label\">Lessee Signature</div>\n                <div class=\"signature-name\">{{ doc.customer_name or doc.customer or \"\" }}</div>\n            </div>\n        </div>\n\n        <div class=\"page-footer\">\n            I have read, understood and agree to the above terms and conditions. | {{ doc.name }} | Page 2 of 2\n        </div>\n    </div>\n    {% endif %}\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
 "margin_top": 15.0,
