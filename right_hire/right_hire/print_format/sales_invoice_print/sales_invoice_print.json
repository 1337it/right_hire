{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2024-01-01 00:00:00",
 "css": ".print-format {\n        font-family: Arial, sans-serif;\n        color: #000;\n        line-height: 1.3;\n        margin: 0 auto;\n        background: white;\n        width:100%;\n        padding:0!important;\n    }",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n    }\n\n    .print-format {\n        font-family: Arial, sans-serif;\n        color: #000;\n        line-height: 1.3;\n        max-width: 210mm;\n        margin: 0 auto;\n        background: white;\n    }\n\n    /* Page container */\n    .page {\n        width: 210mm;\n        min-height: 297mm;\n        padding: 8mm 10mm;\n        position: relative;\n        display: flex;\n        flex-direction: column;\n    }\n\n    .page-content {\n        flex: 1;\n    }\n\n    /* Header Section */\n    .gold-header {\n        background: white;\n        border: 2px solid #B8860B;\n        padding: 8px 12px;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        margin-bottom: 8px;\n    }\n\n    .header-left {\n        color: #000;\n        flex: 1;\n    }\n\n    .company-name {\n        font-size: 14px;\n        font-weight: bold;\n        margin-bottom: 2px;\n        text-transform: uppercase;\n    }\n\n    .company-address {\n        font-size: 9px;\n        line-height: 1.3;\n    }\n\n    .header-logo {\n        width: 120px;\n        height: 60px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .header-logo img {\n        max-width: 100%;\n        max-height: 60px;\n    }\n\n    /* Document Title */\n    .document-title {\n        text-align: center;\n        font-size: 16px;\n        font-weight: bold;\n        margin: 8px 0;\n        text-transform: uppercase;\n        color: {% if doc.is_return %}#cc0000{% else %}#000{% endif %};\n    }\n\n    /* Invoice Header Row */\n    .invoice-header {\n        border: 1px solid #000;\n        display: flex;\n        margin-bottom: 6px;\n    }\n\n    .invoice-header-item {\n        padding: 5px 10px;\n        flex: 1;\n        display: flex;\n        justify-content: space-between;\n        border-right: 1px solid #000;\n        font-size: 10px;\n    }\n\n    .invoice-header-item:last-child {\n        border-right: none;\n    }\n\n    .header-label {\n        font-weight: bold;\n    }\n\n    /* Two Column Layout */\n    .two-column-container {\n        display: flex;\n        gap: 6px;\n        margin-bottom: 6px;\n    }\n\n    .left-column, .right-column {\n        flex: 1;\n        border: 1px solid #000;\n    }\n\n    /* Section Boxes */\n    .section-box {\n        border: 1px solid #000;\n        margin-bottom: 6px;\n    }\n\n    .section-header {\n        background: #e8e8e8;\n        padding: 4px 8px;\n        font-weight: bold;\n        font-size: 10px;\n        text-transform: uppercase;\n        border-bottom: 1px solid #000;\n    }\n\n    .section-content {\n        padding: 6px 10px;\n    }\n\n    .info-row {\n        display: flex;\n        margin-bottom: 3px;\n        font-size: 10px;\n    }\n\n    .info-label {\n        font-weight: bold;\n        min-width: 85px;\n    }\n\n    .info-value {\n        flex: 1;\n    }\n\n    /* Compact info grid */\n    .info-grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 3px 12px;\n    }\n\n    .info-grid-3 {\n        display: grid;\n        grid-template-columns: 1fr 1fr 1fr;\n        gap: 3px 12px;\n    }\n\n    /* Items Table */\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 10px;\n    }\n\n    .items-table th {\n        background: #e8e8e8;\n        padding: 6px 8px;\n        text-align: left;\n        border: 1px solid #000;\n        font-weight: bold;\n    }\n\n    .items-table td {\n        padding: 5px 8px;\n        border: 1px solid #000;\n        vertical-align: top;\n    }\n\n    .items-table .text-right {\n        text-align: right;\n    }\n\n    .items-table .text-center {\n        text-align: center;\n    }\n\n    .items-table tbody tr:nth-child(even) {\n        background: #fafafa;\n    }\n\n    /* Totals Section */\n    .totals-container {\n        display: flex;\n        justify-content: flex-end;\n        margin-top: 6px;\n    }\n\n    .totals-table {\n        width: 50%;\n        border-collapse: collapse;\n        font-size: 10px;\n    }\n\n    .totals-table td {\n        padding: 4px 8px;\n        border: 1px solid #000;\n    }\n\n    .totals-table .label-col {\n        font-weight: bold;\n        text-align: right;\n        width: 60%;\n    }\n\n    .totals-table .amount-col {\n        text-align: right;\n        width: 40%;\n    }\n\n    .totals-table .grand-total {\n        background: #e8e8e8;\n        font-weight: bold;\n        font-size: 11px;\n    }\n\n    .totals-table .grand-total td {\n        border: 1px solid #000;\n        padding: 6px 8px;\n    }\n\n    /* Amount in words */\n    .amount-words {\n        margin-top: 6px;\n        padding: 6px 10px;\n        border: 1px solid #000;\n        font-size: 10px;\n        font-style: italic;\n    }\n\n    /* Remarks/Terms */\n    .remarks-section {\n        margin-top: 6px;\n        padding: 6px 10px;\n        border: 1px solid #ddd;\n        font-size: 9px;\n    }\n\n    .remarks-section strong {\n        display: block;\n        margin-bottom: 3px;\n    }\n\n    /* Footer */\n    .page-footer {\n        text-align: center;\n        font-size: 9px;\n        padding-top: 5px;\n        border-top: 1px solid #ccc;\n        margin-top: 10px;\n    }\n\n    /* Print styles */\n    @media print {\n        .page {\n            page-break-after: always;\n            break-after: page;\n        }\n        .page:last-child {\n            page-break-after: avoid;\n            break-after: avoid;\n        }\n        body {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n    }\n\n    @page {\n        size: A4;\n        margin: 0;\n    }\n</style>\n\n<div class=\"print-format\">\n    <div class=\"page\">\n        <div class=\"page-content\">\n            <!-- Header -->\n            <div class=\"gold-header\">\n                <div class=\"header-left\">\n                    <div class=\"company-name\">{{ doc.company or frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }}</div>\n                    <div class=\"company-address\">\n                        {% set company_doc = frappe.get_doc(\"Company\", doc.company) if doc.company else None %}\n                        {% if company_doc %}\n                        {{ company_doc.address or \"\" }}{% if company_doc.city %} | {{ company_doc.city }}{% endif %}{% if company_doc.country %} {{ company_doc.country }}{% endif %}{% if company_doc.phone_no %} | Tel: {{ company_doc.phone_no }}{% endif %}\n                        {% if company_doc.tax_id %}<br>TRN: {{ company_doc.tax_id }}{% endif %}\n                        {% endif %}\n                    </div>\n                </div>\n                <div class=\"header-logo\">\n                    <img src=\"/files/logo.png\" alt=\"Logo\">\n                </div>\n            </div>\n\n            <!-- Title -->\n            <div class=\"document-title\">\n                {% if doc.is_return %}Credit Note{% else %}Invoice{% endif %}\n            </div>\n\n            <!-- Invoice Header -->\n            {% set schedule_line = frappe.db.get_value(\"Lease Schedule Line\", {\"invoice_ref\": doc.name}, [\"period_start\", \"period_end\"], as_dict=True) %}\n            <div class=\"invoice-header\">\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Invoice No:</span>\n                    <span>{{ doc.name }}</span>\n                </div>\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Date:</span>\n                    <span>{{ frappe.utils.formatdate(doc.posting_date, \"dd-MMM-yyyy\") if doc.posting_date else \"\" }}</span>\n                </div>\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Period:</span>\n                    <span>{% if schedule_line %}{{ frappe.utils.formatdate(schedule_line.period_start, \"dd-MMM\") }} - {{ frappe.utils.formatdate(schedule_line.period_end, \"dd-MMM-yyyy\") }}{% else %}-{% endif %}</span>\n                </div>\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Status:</span>\n                    <span>{{ doc.status or \"Draft\" }}</span>\n                </div>\n            </div>\n\n            <!-- Customer & Vehicle Details -->\n            <div class=\"two-column-container\">\n                <div class=\"left-column\">\n                    <div class=\"section-header\">Bill To</div>\n                    <div class=\"section-content\">\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Customer:</div>\n                            <div class=\"info-value\">{{ doc.customer_name or doc.customer or \"-\" }}</div>\n                        </div>\n                        {% if doc.address_display %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Address:</div>\n                            <div class=\"info-value\">{{ doc.address_display | replace(\"<br>\", \", \") | striptags | truncate(80) }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.contact_mobile %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Mobile:</div>\n                            <div class=\"info-value\">{{ doc.contact_mobile }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.contact_email %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Email:</div>\n                            <div class=\"info-value\">{{ doc.contact_email }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.tax_id %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">TRN:</div>\n                            <div class=\"info-value\">{{ doc.tax_id }}</div>\n                        </div>\n                        {% endif %}\n                    </div>\n                </div>\n                <div class=\"right-column\">\n                    <div class=\"section-header\">Reference Details</div>\n                    <div class=\"section-content\">\n                        {% if doc.vehicle %}\n                        {% set vehicle_model = frappe.db.get_value(\"Vehicle\", doc.vehicle, \"model\") %}\n                        {% set plate_code = frappe.db.get_value(\"Vehicle\", doc.vehicle, \"custom_plate_code\") %}\n                        {% set plate_no = frappe.db.get_value(\"Vehicle\", doc.vehicle, \"plate_no\") %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Vehicle:</div>\n                            <div class=\"info-value\">{{ vehicle_model or doc.vehicle }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Plate No:</div>\n                            <div class=\"info-value\">{{ plate_code }} {{ plate_no }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.lease_agreement %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Lease Agmt:</div>\n                            <div class=\"info-value\">{{ doc.lease_agreement }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.rental_agreement %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Rental Agmt:</div>\n                            <div class=\"info-value\">{{ doc.rental_agreement }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.rental_type %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Rental Type:</div>\n                            <div class=\"info-value\">{{ doc.rental_type }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.is_return and doc.return_against %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Return Against:</div>\n                            <div class=\"info-value\">{{ doc.return_against }}</div>\n                        </div>\n                        {% endif %}\n                    </div>\n                </div>\n            </div>\n\n            <!-- Mileage Details (if available) -->\n            {% if doc.odometer_out or doc.odometer_in or doc.km_driven %}\n            <div class=\"section-box\">\n                <div class=\"section-header\">Mileage Details</div>\n                <div class=\"section-content\">\n                    <div class=\"info-grid-3\">\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">KM Out:</div>\n                            <div class=\"info-value\">{{ \"{:,}\".format(doc.odometer_out|int) if doc.odometer_out else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">KM In:</div>\n                            <div class=\"info-value\">{{ \"{:,}\".format(doc.odometer_in|int) if doc.odometer_in else \"-\" }}</div>\n                        </div>\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">KM Driven:</div>\n                            <div class=\"info-value\">{{ \"{:,}\".format(doc.km_driven|int) if doc.km_driven else \"-\" }}</div>\n                        </div>\n                        {% if doc.free_km %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Free KM:</div>\n                            <div class=\"info-value\">{{ \"{:,}\".format(doc.free_km|int) }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.overage_km %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Overage KM:</div>\n                            <div class=\"info-value\">{{ \"{:,}\".format(doc.overage_km|int) }}</div>\n                        </div>\n                        {% endif %}\n                        {% if doc.overage_rate %}\n                        <div class=\"info-row\">\n                            <div class=\"info-label\">Overage Rate:</div>\n                            <div class=\"info-value\">{{ doc.currency or \"AED\" }} {{ \"{:,.2f}\".format(doc.overage_rate) }}/KM</div>\n                        </div>\n                        {% endif %}\n                    </div>\n                </div>\n            </div>\n            {% endif %}\n\n            <!-- Items Table -->\n            <div class=\"section-box\">\n                <div class=\"section-header\">Invoice Items</div>\n                <table class=\"items-table\">\n                    <thead>\n                        <tr>\n                            <th style=\"width: 5%;\">#</th>\n                            <th style=\"width: 45%;\">Description</th>\n                            <th style=\"width: 15%;\" class=\"text-center\">Qty</th>\n                            <th style=\"width: 15%;\" class=\"text-right\">Rate</th>\n                            <th style=\"width: 20%;\" class=\"text-right\">Amount</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for item in doc.items %}\n                        <tr>\n                            <td class=\"text-center\">{{ loop.index }}</td>\n                            <td>\n                                {{ item.item_name or item.item_code }}\n                                {% if item.description and item.description != item.item_name %}\n                                <br><small style=\"color: #666;\">{{ item.description | striptags | truncate(100) }}</small>\n                                {% endif %}\n                            </td>\n                            <td class=\"text-center\">{{ item.qty }} {{ item.uom or \"\" }}</td>\n                            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.rate or 0) }}</td>\n                            <td class=\"text-right\">{{ \"{:,.2f}\".format(item.amount or 0) }}</td>\n                        </tr>\n                        {% endfor %}\n                    </tbody>\n                </table>\n            </div>\n\n            <!-- Totals -->\n            <div class=\"totals-container\">\n                <table class=\"totals-table\">\n                    <tr>\n                        <td class=\"label-col\">Subtotal:</td>\n                        <td class=\"amount-col\">{{ doc.currency or \"AED\" }} {{ \"{:,.2f}\".format(doc.net_total or doc.total or 0) }}</td>\n                    </tr>\n                    {% if doc.discount_amount %}\n                    <tr>\n                        <td class=\"label-col\">Discount:</td>\n                        <td class=\"amount-col\" style=\"color: #cc0000;\">({{ \"{:,.2f}\".format(doc.discount_amount) }})</td>\n                    </tr>\n                    {% endif %}\n                    {% for tax in doc.taxes %}\n                    <tr>\n                        <td class=\"label-col\">{{ tax.description or tax.account_head }}:</td>\n                        <td class=\"amount-col\">{{ \"{:,.2f}\".format(tax.tax_amount or 0) }}</td>\n                    </tr>\n                    {% endfor %}\n                    {% if doc.total_taxes_and_charges and not doc.taxes %}\n                    <tr>\n                        <td class=\"label-col\">Tax:</td>\n                        <td class=\"amount-col\">{{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }}</td>\n                    </tr>\n                    {% endif %}\n                    <tr class=\"grand-total\">\n                        <td class=\"label-col\">Grand Total:</td>\n                        <td class=\"amount-col\">{{ doc.currency or \"AED\" }} {{ \"{:,.2f}\".format(doc.rounded_total or doc.grand_total or 0) }}</td>\n                    </tr>\n                    {% if doc.outstanding_amount and doc.outstanding_amount != doc.grand_total %}\n                    <tr>\n                        <td class=\"label-col\">Outstanding:</td>\n                        <td class=\"amount-col\" style=\"font-weight: bold; color: {% if doc.outstanding_amount > 0 %}#cc0000{% else %}#008000{% endif %};\">\n                            {{ doc.currency or \"AED\" }} {{ \"{:,.2f}\".format(doc.outstanding_amount) }}\n                        </td>\n                    </tr>\n                    {% endif %}\n                </table>\n            </div>\n\n            <!-- Amount in Words -->\n            {% if doc.in_words %}\n            <div class=\"amount-words\">\n                <strong>Amount in Words:</strong> {{ doc.in_words }}\n            </div>\n            {% endif %}\n\n            <!-- Remarks -->\n            {% if doc.remarks %}\n            <div class=\"remarks-section\">\n                <strong>Remarks:</strong>\n                {{ doc.remarks }}\n            </div>\n            {% endif %}\n\n            <!-- Bank Details and Terms Row -->\n            {% if doc.bank_details_html or doc.invoice_terms %}\n            <div class=\"two-column-container\" style=\"margin-top: 6px;\">\n                {% if doc.bank_details_html %}\n                <div class=\"left-column\">\n                    <div class=\"section-header\">Bank Details</div>\n                    <div class=\"section-content\" style=\"font-size: 9px;\">\n                        {{ doc.bank_details_html | safe }}\n                    </div>\n                </div>\n                {% endif %}\n                {% if doc.invoice_terms %}\n                <div class=\"{% if doc.bank_details_html %}right-column{% else %}left-column{% endif %}\">\n                    <div class=\"section-header\">Terms</div>\n                    <div class=\"section-content\" style=\"font-size: 9px;\">\n                        <ol style=\"margin: 0; padding-left: 16px;\">\n                            {% for term in doc.invoice_terms %}\n                            <li style=\"margin-bottom: 2px;\">{{ term.term }}</li>\n                            {% endfor %}\n                        </ol>\n                    </div>\n                </div>\n                {% endif %}\n            </div>\n            {% endif %}\n        </div>\n\n        <!-- Footer -->\n        <div class=\"page-footer\">\n            {{ doc.name }} | {{ doc.company or frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }} | Printed: {{ frappe.utils.formatdate(frappe.utils.nowdate(), \"dd-MMM-yyyy\") }}\n        </div>\n    </div>\n\n    <!-- Page 2: Toll Transactions -->\n    {% set toll_schedule = frappe.db.get_value(\"Lease Schedule Line\", {\"invoice_ref\": doc.name}, [\"period_start\", \"period_end\"], as_dict=True) %}\n    {% set toll_transactions = frappe.db.get_all(\"Salik Transaction\", filters={\"vehicle\": doc.vehicle, \"transaction_date\": [\"between\", [toll_schedule.period_start, toll_schedule.period_end]]}, fields=[\"plate_number\", \"transaction_date\", \"transaction_time\", \"gate_location\", \"direction\"], order_by=\"transaction_date, transaction_time\") if doc.vehicle and toll_schedule else [] %}\n    {% if toll_transactions %}\n    <div class=\"page\">\n        <div class=\"page-content\">\n            <!-- Header -->\n            <div class=\"gold-header\">\n                <div class=\"header-left\">\n                    <div class=\"company-name\">{{ doc.company or frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }}</div>\n                    <div class=\"company-address\">\n                        {% set company_doc = frappe.get_doc(\"Company\", doc.company) if doc.company else None %}\n                        {% if company_doc %}\n                        {{ company_doc.address or \"\" }}{% if company_doc.city %} | {{ company_doc.city }}{% endif %}{% if company_doc.country %} {{ company_doc.country }}{% endif %}{% if company_doc.phone_no %} | Tel: {{ company_doc.phone_no }}{% endif %}\n                        {% if company_doc.tax_id %}<br>TRN: {{ company_doc.tax_id }}{% endif %}\n                        {% endif %}\n                    </div>\n                </div>\n                <div class=\"header-logo\">\n                    <img src=\"/files/logo.png\" alt=\"Logo\">\n                </div>\n            </div>\n\n            <!-- Title -->\n            <div class=\"document-title\">Toll Charges Details</div>\n\n            <!-- Invoice Reference -->\n            <div class=\"invoice-header\">\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Invoice No:</span>\n                    <span>{{ doc.name }}</span>\n                </div>\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Customer:</span>\n                    <span>{{ doc.customer_name or doc.customer }}</span>\n                </div>\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Vehicle:</span>\n                    <span>{% if doc.vehicle %}{{ frappe.db.get_value(\"Vehicle\", doc.vehicle, \"custom_plate_code\") }} {{ frappe.db.get_value(\"Vehicle\", doc.vehicle, \"plate_no\") }}{% else %}-{% endif %}</span>\n                </div>\n                <div class=\"invoice-header-item\">\n                    <span class=\"header-label\">Total Tolls:</span>\n                    <span>{{ toll_transactions | length }}</span>\n                </div>\n            </div>\n\n            <!-- Toll Transactions Table -->\n            <div class=\"section-box\" style=\"margin-top: 10px;\">\n                <div class=\"section-header\">Salik Toll Transactions</div>\n                <table class=\"items-table\">\n                    <thead>\n                        <tr>\n                            <th style=\"width: 6%;\">#</th>\n                            <th style=\"width: 18%;\">Plate No</th>\n                            <th style=\"width: 18%;\">Date</th>\n                            <th style=\"width: 14%;\">Time</th>\n                            <th style=\"width: 28%;\">Gate</th>\n                            <th style=\"width: 16%;\">Direction</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for toll in toll_transactions %}\n                        <tr>\n                            <td class=\"text-center\">{{ loop.index }}</td>\n                            <td>{{ toll.plate_number or \"-\" }}</td>\n                            <td>{{ frappe.utils.formatdate(toll.transaction_date, \"dd-MMM-yyyy\") if toll.transaction_date else \"-\" }}</td>\n                            <td>{{ (toll.transaction_time | string).split(\".\")[0] if toll.transaction_time else \"-\" }}</td>\n                            <td>{{ toll.gate_location or \"-\" }}</td>\n                            <td>{{ toll.direction or \"-\" }}</td>\n                        </tr>\n                        {% endfor %}\n                    </tbody>\n                </table>\n            </div>\n        </div>\n\n        <!-- Footer -->\n        <div class=\"page-footer\">\n            {{ doc.name }} - Toll Details | {{ doc.company or frappe.db.get_default(\"company\") or \"RIGHT HIRE\" }} | Printed: {{ frappe.utils.formatdate(frappe.utils.nowdate(), \"dd-MMM-yyyy\") }}\n        </div>\n    </div>\n    {% endif %}\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
